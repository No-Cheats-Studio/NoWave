#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct BVHNode {
    vec4 minLeft;
    vec4 maxRight;
    int triIndex;
    int pad0, pad1, pad2;
};

struct GPUTriangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 n;
    int materialIndex;
    int pad0, pad1, pad2;
};

struct GPUMaterial {
    vec4 absorption;
};

struct RayTap {
    int sampleIndex;
    int sourceIndex;
    int receiverIndex;
    int pad0;
    float gainLow;
    float gainMid;
    float gainHigh;
    float pad1;
};

// Muss exakt zu nowave::RaySegment (BVHNode.h) passen: 48 Byte, std430.
// startPosition.w / endPosition.w = Breitbandenergie (0..1), energy* = Energie je Band,
// reflectionIndex = Anzahl bisheriger Reflexionen des Segments.
struct RaySegment {
    vec4 startPosition;
    vec4 endPosition;
    float energyLow;
    float energyMid;
    float energyHigh;
    int reflectionIndex;
};

layout(set = 0, binding = 0, std430) readonly buffer BVHBuf {
    BVHNode nodes[];
};
layout(set = 0, binding = 1, std430) readonly buffer TriBuf {
    GPUTriangle tris[];
};
layout(set = 0, binding = 2, std430) readonly buffer MaterialBuf {
    GPUMaterial materials[];
};
layout(set = 0, binding = 3, std430) buffer TapBuf {
    RayTap taps[];
};
layout(set = 0, binding = 4, std430) buffer CounterBuf {
    uint tapCount;
};
layout(set = 0, binding = 5, std430) readonly buffer ParametersBuf {
    vec4 sourcePositions[2];
    vec4 sourceDirections[2];
    vec4 receiverPositions[2];
    vec4 receiverDirections[2];
    ivec4 configuration;
    ivec4 patterns;
    vec4 physics;
    ivec4 limits;
} simulation;
layout(set = 0, binding = 6, std430) buffer RayPathBuf {
    RaySegment rayPaths[];
};
layout(set = 0, binding = 7, std430) buffer RayPathCounterBuf {
    uint rayPathCount;
};

bool slab(float origin, float direction, float lower, float upper,
          inout float nearT, inout float farT) {
    if (abs(direction) < 1e-8)
        return origin >= lower && origin <= upper;

    float t0 = (lower - origin) / direction;
    float t1 = (upper - origin) / direction;
    nearT = max(nearT, min(t0, t1));
    farT = min(farT, max(t0, t1));
    return farT >= max(nearT, 0.0);
}

bool rayAABB(vec3 ro, vec3 rd, vec3 bmin, vec3 bmax, out float nearT) {
    nearT = 0.0;
    float farT = 1e30;
    return slab(ro.x, rd.x, bmin.x, bmax.x, nearT, farT) &&
           slab(ro.y, rd.y, bmin.y, bmax.y, nearT, farT) &&
           slab(ro.z, rd.z, bmin.z, bmax.z, nearT, farT);
}

bool rayTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out float t) {
    const float EPS = 1e-7;
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 h = cross(rd, e2);
    float a = dot(e1, h);
    if (abs(a) < EPS)
        return false;
    float f = 1.0 / a;
    vec3 s = ro - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0)
        return false;
    vec3 q = cross(s, e1);
    float v = f * dot(rd, q);
    if (v < 0.0 || u + v > 1.0)
        return false;
    t = f * dot(e2, q);
    return t > EPS;
}

bool raySphere(vec3 ro, vec3 rd, vec3 center, float radius, out float t) {
    vec3 oc = ro - center;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - c;
    if (discriminant < 0.0)
        return false;
    float root = sqrt(discriminant);
    t = -b - root;
    if (t < 1e-5)
        t = -b + root;
    return t >= 0.0;
}

bool traverseBVH(vec3 ro, vec3 rd, float maxDistance,
                 out float hitT, out int hitTri, out vec3 hitNormal) {
    hitT = maxDistance;
    hitTri = -1;
    hitNormal = vec3(0.0);

    int stack[32];
    int stackSize = 1;
    stack[0] = 0;
    while (stackSize > 0) {
        int nodeIndex = stack[--stackSize];
        BVHNode node = nodes[nodeIndex];
        float nodeNear;
        if (!rayAABB(ro, rd, node.minLeft.xyz, node.maxRight.xyz, nodeNear) ||
            nodeNear >= hitT)
            continue;

        if (node.triIndex >= 0) {
            GPUTriangle tri = tris[node.triIndex];
            float t;
            if (rayTriangle(ro, rd, tri.v0.xyz, tri.v1.xyz, tri.v2.xyz, t) &&
                t < hitT) {
                hitT = t;
                hitTri = node.triIndex;
                hitNormal = tri.n.xyz;
            }
        } else {
            int left = floatBitsToInt(node.minLeft.w);
            int right = floatBitsToInt(node.maxRight.w);
            if (left >= 0 && stackSize < 32)
                stack[stackSize++] = left;
            if (right >= 0 && stackSize < 32)
                stack[stackSize++] = right;
        }
    }
    return hitTri >= 0;
}

vec3 fibonacciDirection(int index, int count, vec3 axis) {
    float cosine = 1.0 - 2.0 * (float(index) + 0.5) / float(count);
    float radius = sqrt(max(0.0, 1.0 - cosine * cosine));
    float angle = 2.39996323 * float(index);
    vec3 normal = normalize(axis);
    vec3 helper = abs(normal.y) < 0.99
                      ? vec3(0.0, 1.0, 0.0)
                      : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(normal * cosine +
                     tangent * (radius * cos(angle)) +
                     bitangent * (radius * sin(angle)));
}

uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float random01(inout uint state) {
    state = hash(state);
    return float(state) * (1.0 / 4294967295.0);
}

vec3 randomHemisphere(vec3 normal, inout uint state) {
    float z = sqrt(random01(state)); // kosinusgewichtet (Lambert)
    float angle = 6.28318530718 * random01(state);
    float radius = sqrt(max(0.0, 1.0 - z * z));
    vec3 helper = abs(normal.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (radius * cos(angle)) +
                     bitangent * (radius * sin(angle)) + normal * z);
}

float patternGain(int pattern, float forwardDot) {
    float cosine = clamp(forwardDot, -1.0, 1.0);
    if (pattern == 0)
        return 1.0;
    if (pattern == 1)
        return max(0.0, 0.5 * (1.0 + cosine));
    if (pattern == 2)
        return max(0.0, 0.37 + 0.63 * cosine);
    return abs(cosine);
}

float sourcePatternGain(int pattern, float forwardDot) {
    return patternGain(pattern, forwardDot);
}

void recordRaySegment(vec3 start, vec3 end, vec3 amplitude, float totalDistance,
                      int reflectionIndex, bool primary) {
    if (simulation.physics.w <= 0.5)
        return;

    uint pathIndex = atomicAdd(rayPathCount, 1u);
    if (pathIndex < uint(rayPaths.length())) {
        float spreading = 1.0 / max(totalDistance, 0.1);
        float broadband = clamp((amplitude.x + amplitude.y + amplitude.z) / 3.0 * spreading,
                                0.0, 1.0);
        // Primaer: reine Leistung je Strahl (amp^2), die 1/r^2-Abnahme ergibt sich aus der
        // Strahldichte. Hilfssegmente: Pegel am Empfaenger inkl. 1/r.
        vec3 bandEnergy = primary ? amplitude * amplitude
                                  : clamp(amplitude * amplitude * (spreading * spreading), 0.0, 1.0);
        rayPaths[pathIndex].startPosition = vec4(start, broadband);
        rayPaths[pathIndex].endPosition = vec4(end, broadband);
        rayPaths[pathIndex].energyLow = bandEnergy.x;
        rayPaths[pathIndex].energyMid = bandEnergy.y;
        rayPaths[pathIndex].energyHigh = bandEnergy.z;
        rayPaths[pathIndex].reflectionIndex = primary ? reflectionIndex : -1 - reflectionIndex;
    }
}

// amplitude ist der fertige Pegel je Band (inkl. 1/r, Charakteristik, Normierung).
// Laufzeit = Gesamtweg / Schallgeschwindigkeit * Samplerate.
void addTap(float totalDistance, vec3 amplitude, int sourceIndex, int receiverIndex) {
    int sampleIndex = int(totalDistance / simulation.physics.y * simulation.physics.z + 0.5);
    if (sampleIndex < 0 || sampleIndex >= simulation.limits.x)
        return;
    if (max(amplitude.x, max(amplitude.y, amplitude.z)) <= 0.0)
        return;

    uint index = atomicAdd(tapCount, 1u);
    if (index < uint(simulation.limits.y)) {
        taps[index].sampleIndex = sampleIndex;
        taps[index].sourceIndex = sourceIndex;
        taps[index].receiverIndex = receiverIndex;
        taps[index].pad0 = 0;
        taps[index].gainLow = amplitude.x;
        taps[index].gainMid = amplitude.y;
        taps[index].gainHigh = amplitude.z;
        taps[index].pad1 = 0.0;
    }
}

// Verbindet einen Punkt mit allen EmpfÃƒÆ’Ã‚Â¤ngern (Next-Event-Estimation).
// bounce == 0: Direktschall (Quellencharakteristik zum EmpfÃƒÆ’Ã‚Â¤nger).
// bounce > 0: diffuser Anteil einer Reflexion, gewichtet mit Streuanteil * 2cos(ÃƒÅ½Ã‚Â¸).
void connectReceivers(vec3 point, float pathDistance, vec3 pathGain, int bounce,
                      int sourceIndex, vec3 surfaceNormal, float diffuseFraction,
                      float normalization) {
    for (int receiverIndex = 0; receiverIndex < simulation.configuration.y;
         ++receiverIndex) {
        vec3 receiver = simulation.receiverPositions[receiverIndex].xyz;
        vec3 toReceiver = receiver - point;
        float centerDistance = length(toReceiver);
        if (centerDistance < 1e-6)
            continue;
        vec3 dirToReceiver = toReceiver / centerDistance;

        vec3 gain = pathGain;
        if (bounce == 0) {
            float s = sourcePatternGain(simulation.patterns.x,
                                        dot(normalize(simulation.sourceDirections[sourceIndex].xyz),
                                            dirToReceiver));
            gain = vec3(s);
        } else {
            float cosine = dot(surfaceNormal, dirToReceiver);
            if (cosine <= 0.0)
                continue;
            gain *= clamp(diffuseFraction * 2.0 * cosine, 0.0, 2.0);
        }
        if (max(gain.x, max(gain.y, gain.z)) <= 0.0)
            continue;

        float obstructionT;
        int obstructionTri;
        vec3 obstructionNormal;
        if (traverseBVH(point, dirToReceiver, max(0.0, centerDistance - 1e-4),
                        obstructionT, obstructionTri, obstructionNormal))
            continue;

        float receiverGain = patternGain(
            simulation.patterns[receiverIndex + 1],
            dot(normalize(simulation.receiverDirections[receiverIndex].xyz),
                -dirToReceiver));
        float totalDistance = pathDistance + centerDistance;
        vec3 weighted = gain * receiverGain * normalization;
        addTap(totalDistance, weighted / max(totalDistance, 0.1), sourceIndex, receiverIndex);
        recordRaySegment(point, receiver, weighted, totalDistance, bounce, false);
    }
}

void main() {
    int workIndex = int(gl_GlobalInvocationID.x);
    int numRays = simulation.limits.z;
    int totalWork = numRays * simulation.configuration.x;
    if (workIndex >= totalWork)
        return;

    int sourceIndex = workIndex / numRays;
    int rayIndex = workIndex - sourceIndex * numRays;
    int maxBounces = simulation.limits.w;
    float radius = simulation.physics.x;
    vec3 origin = simulation.sourcePositions[sourceIndex].xyz;
    vec3 sourceDirection = normalize(simulation.sourceDirections[sourceIndex].xyz);
    vec3 direction = fibonacciDirection(rayIndex, numRays, sourceDirection);
    float sourceGain = sourcePatternGain(simulation.patterns.x,
                                         dot(sourceDirection, direction));
    float pathDistance = 0.0;
    // Amplitudenfaktor je Band (Low, Mid, High)
    vec3 pathGain = vec3(sourceGain);
    bool specularChain = true;
    uint randomState = uint(workIndex + 1) * 0x9e3779b9u;

    // Direktschall deterministisch, genau einmal je Quelle.
    if (rayIndex == 0)
        connectReceivers(origin, 0.0, vec3(1.0), 0, sourceIndex, vec3(0.0), 0.0, 1.0);

    for (int bounce = 0; bounce <= maxBounces; ++bounce) {
        if (bounce == 0 && sourceGain <= 0.0)
            break;

        float hitT;
        int hitTri;
        vec3 hitNormal;
        if (!traverseBVH(origin, direction, 1e30, hitT, hitTri, hitNormal))
            break;

        // Kugeltreffer spekularer Pfade ab der ersten Reflexion. Erwartete Trefferzahl
        // N rÃƒâ€šÃ‚Â²/(4 dÃƒâ€šÃ‚Â²) => Gewicht 4d/(N rÃƒâ€šÃ‚Â²) liefert im Mittel die Amplitude 1/d.
        if (bounce >= 1 && specularChain) {
            for (int receiverIndex = 0; receiverIndex < simulation.configuration.y;
                 ++receiverIndex) {
                vec3 receiver = simulation.receiverPositions[receiverIndex].xyz;
                vec3 toReceiver = receiver - origin;
                float along = dot(toReceiver, direction);
                if (along <= 0.0 || along >= hitT)
                    continue;
                if (length(toReceiver - direction * along) > radius)
                    continue;
                float totalDistance = pathDistance + along;
                float receiverGain = patternGain(
                    simulation.patterns[receiverIndex + 1],
                    dot(normalize(simulation.receiverDirections[receiverIndex].xyz),
                        -direction));
                vec3 weighted = pathGain * receiverGain * 4.0 * totalDistance /
                                (float(numRays) * radius * radius);
                addTap(totalDistance, weighted, sourceIndex, receiverIndex);
                recordRaySegment(origin, origin + direction * along,
                                 weighted * max(totalDistance, 0.1), totalDistance, bounce, false);
            }
        }

        recordRaySegment(origin, origin + direction * hitT, pathGain,
                         pathDistance + hitT, bounce, true);

        if (bounce == maxBounces)
            break;

        vec3 hitPoint = origin + direction * hitT;
        pathDistance += hitT;
        GPUTriangle tri = tris[hitTri];
        GPUMaterial material = materials[tri.materialIndex];
        // absorption ist ein Energiegrad; die Amplitude skaliert mit sqrt(1 - alpha).
        pathGain.x *= sqrt(clamp(1.0 - material.absorption.x, 0.0, 1.0));
        pathGain.y *= sqrt(clamp(1.0 - material.absorption.y, 0.0, 1.0));
        pathGain.z *= sqrt(clamp(1.0 - material.absorption.z, 0.0, 1.0));
        if (max(pathGain.x, max(pathGain.y, pathGain.z)) < 1e-5)
            break;

        vec3 normal = dot(hitNormal, direction) < 0.0 ? hitNormal : -hitNormal;
        float scattering = clamp(material.absorption.w, 0.0, 1.0);
        vec3 surfacePoint = hitPoint + normal * 1e-4;

        if (scattering > 0.0)
            connectReceivers(surfacePoint, pathDistance, pathGain, bounce + 1,
                             sourceIndex, normal, scattering, 1.0 / float(numRays));

        // Diffus mit Wahrscheinlichkeit = Streuung, sonst spiegelnd.
        if (random01(randomState) < scattering) {
            direction = randomHemisphere(normal, randomState);
            specularChain = false;
        } else {
            direction = normalize(reflect(direction, normal));
        }
        origin = surfacePoint;
    }
}