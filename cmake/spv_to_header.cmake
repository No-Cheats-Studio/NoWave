# cmake/spv_to_header.cmake
# Reads SPV_FILE, writes a byte-array C header to HEADER_FILE.
# Usage: cmake -DSPV_FILE=... -DHEADER_FILE=... -P spv_to_header.cmake

file(READ "${SPV_FILE}" SPV_HEX HEX)
string(LENGTH "${SPV_HEX}" HEX_LEN)
math(EXPR NUM_BYTES "${HEX_LEN} / 2")

set(CONTENT "// Auto-generated by cmake/spv_to_header.cmake -- do not edit.\n")
string(APPEND CONTENT "#pragma once\n")
string(APPEND CONTENT "#include <cstdint>\n\n")
string(APPEND CONTENT "namespace nowave { namespace shaders {\n\n")
string(APPEND CONTENT "alignas(4) static const uint8_t kRaytracerSPV[] = {\n    ")

set(COL 0)
foreach(i RANGE ${NUM_BYTES})
    if(${i} EQUAL ${NUM_BYTES})
        break()
    endif()
    math(EXPR OFF "${i} * 2")
    string(SUBSTRING "${SPV_HEX}" ${OFF} 2 B)
    string(APPEND CONTENT "0x${B},")
    math(EXPR COL "${COL} + 1")
    if(${COL} EQUAL 16)
        string(APPEND CONTENT "\n    ")
        set(COL 0)
    else()
        string(APPEND CONTENT " ")
    endif()
endforeach()

string(APPEND CONTENT "\n};\n\n")
string(APPEND CONTENT "static const uint32_t kRaytracerSPVSizeBytes = ${NUM_BYTES};\n\n")
string(APPEND CONTENT "} } // namespace nowave::shaders\n")

file(WRITE "${HEADER_FILE}" "${CONTENT}")
message(STATUS "Generated ${HEADER_FILE} (${NUM_BYTES} bytes)")

